# Copy to bridge/.env and edit. NEVER commit the real .env.

# --- Where captures are sent ---------------------------------------------
BACKEND_URL=http://127.0.0.1:8000
# Must match BRIDGE_TOKEN in backend/.env
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Physical room this capture PC lives in. The backend uses it to work out which
# patient is in the chair, so the bridge never has to know patient identity.
OPERATORY=OP-1

# --- Capture sources ------------------------------------------------------
# Comma-separated, all started together. Available:
#   wpd        USB MTP/PTP via Windows Portable Devices (Canon/Nikon/Sony)
#   shell      USB MTP fallback through the Windows Shell (use if wpd fails)
#   folder     watch folders written by vendor tether software / Wi-Fi import
#   ftp        built-in FTP server; Wi-Fi cameras push each frame here directly
#   removable  auto-import DCIM from an SD card or camera in mass-storage mode
#   simulator  replay sample images on a timer (demo without hardware)
#   canon      Canon EDSDK adapter            (requires CANON_EDSDK_DLL)
#   nikon      Nikon SDK adapter              (requires NIKON_SDK_DLL)
#   sony       Sony Camera Remote SDK adapter (requires SONY_SDK_DLL)
ENABLED_SOURCES=wpd,folder,removable

# Folders watched by the "folder" source (semicolon separated).
WATCH_FOLDERS=./watch

# File types treated as clinical images.
IMAGE_EXTENSIONS=.jpg,.jpeg,.png,.tif,.tiff,.heic,.cr2,.cr3,.nef,.arw

# How often USB / removable sources are polled, in seconds. This is the single
# biggest component of the delay between pressing the shutter and seeing the
# photograph on the chart - the rest is just pulling the file over USB.
# The MTP path will not go below 1.0s however low this is set.
POLL_INTERVAL_SECONDS=0.5

# How often the bridge checks in. The reply carries the current capture window,
# so this is also how quickly the bridge learns that a session has opened.
HEARTBEAT_SECONDS=5

# --- Reliability ----------------------------------------------------------
SPOOL_DIR=./spool
MAX_UPLOAD_ATTEMPTS=8

# --- Wi-Fi cameras (the "ftp" source) -------------------------------------
# Point the camera's FTP transfer at this PC's LAN address and this port.
# Port 2121 avoids needing administrator rights to bind; set it on the camera
# alongside the address. The source refuses to start unless FTP_PASSWORD is set
# - an anonymous drop box on a practice network is never acceptable.
FTP_HOST=0.0.0.0
FTP_PORT=2121
FTP_USER=camera
FTP_PASSWORD=
# Data-channel ports for passive mode, which is what cameras use. Open exactly
# this range plus FTP_PORT on the Windows firewall. Left to the OS this would be
# a random high port per transfer, and a camera would log in fine then stall.
FTP_PASSIVE_PORTS=50000-50100
# Landing directory. Files are emptied out of it as fast as they arrive; the
# backend's patient folders are the store of record.
FTP_ROOT=./ftp-incoming

# --- Simulator ------------------------------------------------------------
SIMULATOR_FOLDER=./sample-captures
SIMULATOR_INTERVAL_SECONDS=6

# --- Vendor SDKs (optional; leave blank unless the SDK is installed) -------
CANON_EDSDK_DLL=
NIKON_SDK_DLL=
SONY_SDK_DLL=

LOG_LEVEL=INFO
