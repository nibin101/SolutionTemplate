# Copy to backend/.env and edit. NEVER commit the real .env.

# Shared secret the camera bridge must send in the X-Bridge-Token header.
# Generate one with:  python -c "import secrets;print(secrets.token_urlsafe(32))"
BRIDGE_TOKEN=change-me-to-a-long-random-string

# Where ingested images and the SQLite database live (relative paths are
# resolved against the backend/ directory).
DATA_DIR=./data

# Host/port the API listens on.
HOST=127.0.0.1
PORT=8000

# Serve the static chair-side UI from ../frontend/public at "/".
SERVE_FRONTEND=true

# Images that arrive while no capture session is open are held here for manual
# assignment instead of being guessed onto a patient. Keep true in clinical use.
QUARANTINE_UNASSIGNED=true

# --- Quality gate (app/quality.py) ----------------------------------------
# Screens every capture with OpenCV before it is stored: a blurry photo, or an
# extraoral shot (frontal/smile/repose) with no face in frame, is rejected
# rather than charted - the bridge's spool keeps the bytes and shows the
# reason so it can be retaken, exactly like any other rejected upload.
QUALITY_GATE_ENABLED=true
# Longest edge, in px, of the in-memory copy the checks run on. Smaller is
# faster; the blur threshold below is calibrated for this size.
QUALITY_ANALYSIS_MAX_PX=512
QUALITY_BLUR_ENABLED=true
# Laplacian variance floor. Below this the photo is rejected as out of focus.
# Raise it to reject more aggressively, lower it if real captures are being
# wrongly rejected.
QUALITY_BLUR_MIN_VARIANCE=60.0
QUALITY_FACE_ENABLED=true
# A face is REQUIRED when the shot's view (sent by the simulator) or filename
# contains one of these words - comma-separated, case-insensitive.
QUALITY_FACE_REQUIRED_KEYWORDS=frontal,smile,repose,face,extraoral
# A face is looked for but never enforced for these.
QUALITY_FACE_OPTIONAL_KEYWORDS=profile
# These always mean "no face expected", even alongside a word above - "frontal"
# alone is ambiguous (an intraoral "frontal retracted" shot vs. an extraoral
# "frontal smile" portrait); an intraoral term settles it.
QUALITY_INTRAORAL_OVERRIDE_KEYWORDS=retracted,occlusal,buccal,lingual,palatal,intraoral
# Smallest face, in px, the detector will count - filters out false positives
# on small/distant features.
QUALITY_MIN_FACE_PX=20

# --- CareStack PMS (optional) ---------------------------------------------
# Used by app/carestack.py, the client for the Patient Documents API. Nothing
# in the ingest path calls it yet, so these can be left exactly as they are;
# keep CARESTACK_MOCK=true unless you have real credentials to test against.
CARESTACK_BASE_URL=https://api.carestack.com
CARESTACK_CLIENT_ID=
CARESTACK_CLIENT_SECRET=
CARESTACK_MOCK=true
