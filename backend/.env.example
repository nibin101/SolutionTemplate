# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real credentials.

# ─── Camera mode ────────────────────────────────────────────────────────────
# "tether" → USB camera via gphoto2 (Canon/Nikon/Sony)
# "watch"  → watch INBOX_PATH for new files (SD card / folder drop)
# "mock"   → demo mode, no hardware needed
CAMERA_MODE=mock

# ─── Paths ──────────────────────────────────────────────────────────────────
INBOX_PATH=./inbox
OUTBOX_PATH=./outbox
MANIFEST_PATH=./outbox/.manifest.json
DEMO_IMAGES_PATH=./demo_images
SESSION_CONFIG_PATH=./config.json

# ─── CareStack API ──────────────────────────────────────────────────────────
# Leave blank and set CARESTACK_MOCK=true for demo / development
CARESTACK_BASE_URL=https://api.carestack.com
CARESTACK_CLIENT_ID=
CARESTACK_CLIENT_SECRET=
CARESTACK_MOCK=true

# ─── Server ─────────────────────────────────────────────────────────────────
PORT=8000